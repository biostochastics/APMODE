{"pk": "1244", "sid": "PKDB00832", "name": "Richer1984", "licence": "open", "access": "public", "date": "2024-06-15", "group_count": 1, "individual_count": 10, "intervention_count": 1, "output_count": 121, "output_calculated_count": 24, "subset_count": 10, "timecourse_count": 10, "scatter_count": 0, "reference": {"pk": 1251, "study": {"sid": "PKDB00832", "name": "Richer1984"}, "pmid": "6324834", "sid": "6324834", "name": "Richer1984", "doi": "10.1111/j.1365-2125.1984.tb02338.x", "title": "Captopril: pharmacokinetics, antihypertensive and biological effects in hypertensive patients.", "abstract": "The kinetics of captopril plasma levels and of the drug-induced plasma converting enzyme activity (PCEA), plasma renin activity (PRA) and diastolic blood pressure (DBP) modifications were studied over 24 h after oral administration of captopril, 1 mg/kg, to ten hypertensive patients. Free unchanged captopril pharmacokinetic parameters were: t1/2, alpha: 0.45 +/- 0.06 h; tmax: 0.98 +/- 0.13 h; Cmax: 1.31 +/- 0.20 mg l-1; t1/2,z: 0.66 +/- 0.13 h; V: 0.614 +/- 0.104 1 kg-1 and CLtot: 0.690 +/- 0.082 l h-1 kg-1. At 6 h captopril was no longer detectable in plasma. The onset of PCEA inhibition and of DBP decrease closely followed the rise of captopril's plasma levels, while that of PRA increase was delayed. In contrast, while captopril rapidly disappeared from plasma, its biological and antihypertensive effects were long-lasting. The lack of correlation between the relative bioavailability of captopril and the induced reduction in DBP (evaluated by the corresponding AUCs) suggests that free unchanged captopril plasma monitoring is not an adequate indicator of hypertensive patients' potential responsiveness to captopril's blood pressure lowering effects.", "journal": "British journal of clinical pharmacology", "date": "1984-06-05", "authors": [{"pk": 7199, "first_name": "C", "last_name": "Richer"}, {"pk": 7200, "first_name": "B", "last_name": "Giroux"}, {"pk": 7201, "first_name": "P F", "last_name": "Plouin"}, {"pk": 7202, "first_name": "B", "last_name": "Maarek"}, {"pk": 7203, "first_name": "J F", "last_name": "Giudicelli"}]}, "reference_date": "1984-06-05", "creator": {"username": "MariiaMysh", "first_name": "Mariia", "last_name": "Myshkina"}, "curators": [{"rating": 2.5, "username": "MariiaMysh", "first_name": "Mariia", "last_name": "Myshkina"}, {"rating": 0.0, "username": "mkoenig", "first_name": "Matthias", "last_name": "K\u00f6nig"}], "collaborators": [], "comments": [], "descriptions": [{"pk": 4566, "text": "Pharmacokinetics, antihypertensive and biological effects of captopril in hypertensive patients."}], "files": [{"pk": 15033, "name": "data/Richer1984_Fig1.png", "file": "/media/data/Richer1984_Fig1.png"}, {"pk": 15030, "name": "data/.Richer1984_Fig1.tsv", "file": "/media/data/.Richer1984_Fig1.tsv"}, {"pk": 15027, "name": "data/Richer1984.pdf", "file": "/media/data/Richer1984.pdf"}, {"pk": 15035, "name": "data/Richer1984_Tab2.png", "file": "/media/data/Richer1984_Tab2.png"}, {"pk": 15036, "name": "data/.Richer1984_Tab2.tsv", "file": "/media/data/.Richer1984_Tab2.tsv"}, {"pk": 15028, "name": "data/.Richer1984_Tab3Mean.tsv", "file": "/media/data/.Richer1984_Tab3Mean.tsv"}, {"pk": 15037, "name": "data/Richer1984_Tab3.png", "file": "/media/data/Richer1984_Tab3.png"}, {"pk": 15031, "name": "data/.Richer1984_Tab4Mean.tsv", "file": "/media/data/.Richer1984_Tab4Mean.tsv"}, {"pk": 15026, "name": "data/Richer1984_Tab4.png", "file": "/media/data/Richer1984_Tab4.png"}, {"pk": 15034, "name": "data/.Richer1984_TabGroups.tsv", "file": "/media/data/.Richer1984_TabGroups.tsv"}, {"pk": 15029, "name": "data/.Richer1984_TabIndividuals.tsv", "file": "/media/data/.Richer1984_TabIndividuals.tsv"}, {"pk": 15032, "name": "data/.Richer1984_TabInterventions.tsv", "file": "/media/data/.Richer1984_TabInterventions.tsv"}, {"pk": 15025, "name": "data/Richer1984.xlsx", "file": "/media/data/Richer1984.xlsx"}], "substances": [{"sid": "captopril", "name": "captopri