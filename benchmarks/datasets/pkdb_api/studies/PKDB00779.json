{"pk": "1265", "sid": "PKDB00779", "name": "Kelly1986", "licence": "open", "access": "public", "date": "2024-04-24", "group_count": 9, "individual_count": 36, "intervention_count": 3, "output_count": 365, "output_calculated_count": 18, "subset_count": 6, "timecourse_count": 6, "scatter_count": 0, "reference": {"pk": 1273, "study": {"sid": "PKDB00779", "name": "Kelly1986"}, "pmid": "3004546", "sid": "3004546", "name": "Kelly1986", "doi": "10.1111/j.1365-2125.1986.tb02823.x", "title": "Pharmacokinetics of enalapril in normal subjects and patients with renal impairment.", "abstract": "The pharmacokinetics of enalaprilat were studied after administration of single and multiple doses of enalapril maleate to people with normal and impaired renal function. Renal impairment was associated with higher serum concentrations of enalaprilat, longer times to peak concentrations, slower decline of serum concentrations and with reduced urinary elimination. Urinary elimination of enalaprilat was closely related to renal function. In patients with severe renal impairment (GFR values below 30 ml min-1 1.73 m-2) significantly smaller doses of enalapril maleate will be required than in patients with normal or less severely impaired renal function.", "journal": "British journal of clinical pharmacology", "date": "1986-04-09", "authors": [{"pk": 7330, "first_name": "J G", "last_name": "Kelly"}, {"pk": 7331, "first_name": "G", "last_name": "Doyle"}, {"pk": 7332, "first_name": "J", "last_name": "Donohue"}, {"pk": 7333, "first_name": "M", "last_name": "Laher"}, {"pk": 7334, "first_name": "M J", "last_name": "Vandenburg"}, {"pk": 7335, "first_name": "W J", "last_name": "Currie"}, {"pk": 7336, "first_name": "W D", "last_name": "Cooper"}]}, "reference_date": "1986-04-09", "creator": {"username": "shubhankarpalwankar", "first_name": "Shubhankar", "last_name": "Palwankar"}, "curators": [{"rating": 3.5, "username": "shubhankarpalwankar", "first_name": "Shubhankar", "last_name": "Palwankar"}, {"rating": 3.5, "username": "mkoenig", "first_name": "Matthias", "last_name": "K\u00f6nig"}], "collaborators": [], "comments": [], "descriptions": [{"pk": 4719, "text": "Single dose study"}, {"pk": 4720, "text": "Twenty-four subjects aged 19 to 70 years, with varying degrees of renal function were studied"}, {"pk": 4721, "text": "Six subjects were chosen to fill each of four groups, based on glomerular filtration rate (GFR)"}, {"pk": 4722, "text": "The first group (Group 1) comprised six healthy volunteers with GFR valus greater than 100 ml/min/(1.73*m^2)"}, {"pk": 4723, "text": "The remaining groups were chosen from patients with various degrees of renal dysfunction as follows: Group 2: GFR 31-8ml/min/(1.73*m^2). Group 3: GFR 10-30 ml/min/(1.73*m^2). Group 4: GFR less than 10 ml/min/(1.73*m^2)."}, {"pk": 4724, "text": "Multiple dose study"}, {"pk": 4725, "text": "Group I was a group of healthy volunteers with values of GFR in excess of 100 ml/min/(1.73*m^2)"}, {"pk": 4726, "text": "Group 2 was a group of people having severely impaired renal function with values of GFR no greater than 28 ml/min/(1.73*m^2)"}], "files": [{"pk": 15379, "name": "data/Kelly1986_Fig1.png", "file": "/media/data/Kelly1986_Fig1.png"}, {"pk": 15384, "name": "data/.Kelly1986_Fig1.tsv", "file": "/media/data/.Kelly1986_Fig1.tsv"}, {"pk": 15371, "name": "data/Kelly1986_Fig2.png", "file": "/media/data/Kelly1986_Fig2.png"}, {"pk": 15375, "name": "data/.Kelly1986_Fig2.tsv", "file": "/media/data/.Kelly1986_Fig2.tsv"}, {"pk": 15387, "name": "data/Kelly1986_Fig3.png", "file": "/media/data/Kelly1986_Fig3.png"}, {"pk": 15385, "name": "data/.Kelly1986_Fig3.tsv", "file": "/media/data/.Kelly1986_Fig3.tsv"}, {"pk": 15367, "name": "data/Kelly1986_Fig4.png", "file": "/media/data/Kelly1986_Fig4.png"}, {"pk": 15382, "name": "data/.Kelly1986_Fig4.tsv", "file": "/media/data/.Kelly1986_Fig4.tsv"}, {"pk": 15372, "name": "data/Kelly1986_Fig5.png", "file": "/media/data/Kelly1986_Fig5.png"}, {"pk": 15368, "name": "data/.Kelly1986_Fig5.tsv", "file": "/media/data/.Kelly1986_Fig5.tsv"}, {"pk": 15386, "name": "data/Kelly1986_Fig6.png", "file": "/media/data/Kelly1986_Fig6.png"}, {"pk": 15366, "name": "data/.Kelly1986_Fig6.tsv", "file": "/media/data/.Kelly1986_Fig6.tsv"}, {"pk": 15369, "name": "data/Kelly1986_Fig7.png", "file": "/media/data/Kelly1986_Fig7.png"}, {"pk": 15378, "name": "data/.Kelly1986_Fig7.tsv", "file": "/media/data/.Kelly1986_Fig7.tsv"}, {"pk": 15381, "name": "data/Kelly1986.pdf", "file": "/media/data/Kelly1986.pdf"}, {"pk": 15370, "name": "data/Kelly1986_Tab1.png", "file": "/media/data/Kelly1986_Tab1.png"}, {"pk": 15365, "name": "data/.Kelly1986_Tab1.tsv", "file": "/media/data/.Kelly1986_Tab1.tsv"}, {"pk": 15383, "name": "data/Kelly1986_Tab2.png", "file": "/media/data/Kelly1986_Tab2.png"}, {"pk": 15374, "name": "data/.Kelly1986_Tab2.tsv", "file": "/media/data/.Kelly1986_Tab2.tsv"}, {"pk": 15373, "name": "data/.Kelly1986_TabGroups.tsv", "file": "/media/data/.Kelly1986_TabGroups.tsv"}, {"pk": 15376, "name": "data/.Kelly1986_TabIndividuals.tsv", "file": "/media/data/.Kelly1986_TabIndividuals.tsv"}, {"pk": 15380, "name": "data/.Kelly1986_TabInterventions.tsv", "file": "/media/data/.Kelly1986_TabInterventions.tsv"}, {"pk": 15377, "name": "data/Kelly1986.xlsx", "file": "/media/data/Kelly1986.xlsx"}], "substances": [{"sid": "enalapril-maleate", "name": "enalapril maleate", "label": "enalapril maleate"}, {"sid": "enalaprilat", "name": "enalaprilat", "label": "enalaprilat"}], "groupset": {"descriptions": [{"pk": 4727, "text": "Single dose study"}, {"pk": 4728, "text": "Enalapril maleate 10 mg was administered at 08.00 h"}, {"pk": 4729, "text": "Blood specimens (5-10 ml) were obtained beforeandat 1, 2, 3, 4, 5, 6, 8, 10, 12and24h after drug administration"}, {"pk": 4730, "text": "Urine specimens for determination of enalaprilat concentrations were collected over the following time periods after dose: 0-2, 2-4, 4-6, 6-8,8-12, 12-24 and 24-28 h."}, {"pk": 4731, "text": "Multiple dose study"}, {"pk": 4732, "text": "Group I was a group of healthy volunteers with values of GFR in excess of 100 ml/min/(1.73*m^2)"}, {"pk": 4733, "text": "These subjects received enalapril maleate as a single 10 mg dose on each of seven successive mornings"}, {"pk": 4734, "text": "After the last dose of enalapril maleate, blood specimens were obtained at 4, 12, 24, 36 and 48 h for estimation of serum enalaprilat concentrations"}, {"pk": 4735, "text": "Group 2 was a group of people having severely impaired renal function with values of GFR no greater than 28 ml/min/(1.73*m^2)"}, {"pk": 4736, "text": "Each person received enalapril maleate as a single 2.5 mg dose every morning for 7 days"}, {"pk": 4737, "text": "Following the last dose of enalapril maleate, blood specimens were obtained at 9, 24, 33, 48, 57, 72, 96, 120, 144 and 168 h"}], "comments": [], "groups": [3731, 3732, 3733, 3734, 3735, 3736, 3737, 3738, 3739]}, "individualset": {"descriptions": [], "comments": [], "individuals": [21137, 21138, 21139, 21140, 21141, 21142, 21143, 21144, 21145, 21146, 21147, 21148, 21149, 21150, 21151, 21152, 21153, 21154, 21155, 21156, 21157, 21158, 21159, 21160, 21161, 21162, 21163, 21164, 21165, 21166, 21167, 21168, 21169, 21170, 21171, 21172]}, "interventionset": {"descriptions": [{"pk": 4738, "text": "Single dose study"}, {"pk": 4739, "text": "Enalapril maleate 10 mg was administered at 08.00 h"}, {"pk": 4740, "text": "Multiple dose study"}, {"pk": 4741, "text": "These subjects received enalapril maleate as a single 10 mg dose on each of seven successive mornings"}, {"pk": 4742, "text": "Each person received enalapril maleate as a single 2.5 mg dose every morning for 7 days"}], "comments": [], "interventions": [7064, 7065, 7066]}, "outputset": {"descriptions": [], "comments": [], "outputs": [362420, 362421, 362422, 362423, 362424, 362425, 362426, 362427, 362428, 362429, 362430, 362431, 362432, 362433, 362434, 362435, 362436, 362437, 362438, 362439, 362440, 362441, 362442, 362