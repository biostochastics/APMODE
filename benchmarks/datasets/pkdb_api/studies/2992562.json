{"pk": "735", "sid": "2992562", "name": "Manhem1985", "licence": "open", "access": "public", "date": "2025-10-07", "group_count": 1, "individual_count": 0, "intervention_count": 4, "output_count": 291, "output_calculated_count": 67, "subset_count": 52, "timecourse_count": 52, "scatter_count": 0, "reference": {"pk": 738, "study": {"sid": "2992562", "name": "Manhem1985"}, "pmid": "2992562", "sid": "2992562", "name": "Manhem1985", "doi": "10.1111/j.1365-2125.1985.tb02794.x", "title": "A dose-response study of HOE 498, a new non-sulphydryl converting enzyme inhibitor, on blood pressure, pulse rate and the renin-angiotensin-aldosterone system in normal man.", "abstract": "The effect of different oral doses of HOE 498, a new non-sulphydryl containing converting enzyme inhibitor, was investigated in a double-blind, placebo-controlled study in normotensive volunteers. Dose-related reductions in serum converting enzyme activity, plasma angiotensin II and aldosterone were seen, greater at 4 h than at 12 h after drug ingestion. Converse dose-related increases in blood angiotensin I and plasma active renin concentration occurred. Falls of angiotensin II were as great with 20 mg as with 50 mg of HOE 498, although the effect was more prolonged with 50 mg. The reductions in concentrations of plasma angiotensin II and serum converting enzyme activity and the increases in plasma renin concentration were correlated with the concentration of HOE 498 - diacid in plasma. Dose-related falls in both supine and erect blood pressure were maximal 2-3.5 h after dosing. Pulse rate increased marginally but insignificantly in the supine; slightly and significantly in the upright position, concomitantly with the blood pressure reduction at all doses of active drug. We conclude that effects of single doses of HOE 498 on the renin-angiotensin system are maximal within 4 h, but are still apparent after 24 h. Thus it is likely that once daily administration will be adequate for treatment of high blood pressure in patients.", "journal": "British journal of clinical pharmacology", "date": "1985-10-24", "authors": [{"pk": 4355, "first_name": "P J", "last_name": "Manhem"}, {"pk": 4356, "first_name": "S G", "last_name": "Ball"}, {"pk": 4357, "first_name": "J J", "last_name": "Morton"}, {"pk": 4358, "first_name": "G D", "last_name": "Murray"}, {"pk": 4359, "first_name": "B J", "last_name": "Leckie"}, {"pk": 4360, "first_name": "R", "last_name": "Fraser"}, {"pk": 4361, "first_name": "J I", "last_name": "Robertson"}]}, "reference_date": "1985-10-24", "creator": {"username": "lucialink30", "first_name": "Lucia", "last_name": "Link"}, "curators": [{"rating": 0.0, "username": "xresearch", "first_name": "XResearch", "last_name": "Group"}, {"rating": 4.5, "username": "lucialink30", "first_name": "Lucia", "last_name": "Link"}, {"rating": 1.5, "username": "mkoenig", "first_name": "Matthias", "last_name": "K\u00f6nig"}], "collaborators": [], "comments": [], "descriptions": [], "files": [{"pk": 9053, "name": "data/Manhem1985_Fig2.png", "file": "/media/data/Manhem1985_Fig2.png"}, {"pk": 9052, "name": "data/Manhem1985_Fig3.png", "file": "/media/data/Manhem1985_Fig3.png"}, {"pk": 9060, "name": "data/Manhem1985_Fig4.png", "file": "/media/data/Manhem1985_Fig4.png"}, {"pk": 9063, "name": "data/.Manhem1985_Fig4.tsv", "file": "/media/data/.Manhem1985_Fig4.tsv"}, {"pk": 9051, "name": "data/Manhem1985.pdf", "file": "/media/data/Manhem1985.pdf"}, {"pk": 9054, "name": "data/Manhem1985_Tab1.png", "file": "/media/data/Manhem1985_Tab1.png"}, {"pk": 9050, "name": "data/.Manhem1985_Tab1.tsv", "file": "/media/data/.Manhem1985_Tab1.tsv"}, {"pk": 9058, "name": "data/Manhem1985_Tab2.png", "file": "/media/data/Manhem1985_Tab2.png"}, {"pk": 9057, "name": "data/.Manhem1985_Tab2.tsv", "file": "/media/data/.Manhem1985_Tab2.tsv"}, {"pk": 9064, "name": "data/Manhem1985_Tab3.png", "file": "/media/data/Manhem1985_Tab3.png"}, {"pk": 9059, "name": "data/.Manhem1985_Tab3.tsv", "file": "/media/data/.Manhem1985_