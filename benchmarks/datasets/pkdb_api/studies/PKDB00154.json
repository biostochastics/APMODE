{"pk": "390", "sid": "PKDB00154", "name": "Liukas2011", "licence": "open", "access": "public", "date": "2019-07-28", "group_count": 5, "individual_count": 238, "intervention_count": 1, "output_count": 615, "output_calculated_count": 69, "subset_count": 12, "timecourse_count": 12, "scatter_count": 0, "reference": {"pk": 391, "study": {"sid": "PKDB00154", "name": "Liukas2011"}, "pmid": "21241071", "sid": "21241071", "name": "Liukas2011", "doi": null, "title": "Pharmacokinetics of intravenous paracetamol in elderly patients.", "abstract": "Age and sex are important factors affecting the pharmacokinetics of paracetamol. The higher the age of the patient, the higher is the exposure to paracetamol. Female sex is associated with increased paracetamol concentrations but ABCG2 genotype does not seem to affect paracetamol pharmacokinetics. Trial registration number (EudraCT): 2006-001917-14.", "journal": "Clinical pharmacokinetics", "date": "2011-08-01", "authors": [{"pk": 2133, "first_name": "Antti", "last_name": "Liukas"}, {"pk": 2134, "first_name": "Kristiina", "last_name": "Kuusniemi"}, {"pk": 2135, "first_name": "Riku", "last_name": "Aantaa"}, {"pk": 2136, "first_name": "Petri", "last_name": "Virolainen"}, {"pk": 2137, "first_name": "Mikko", "last_name": "Niemi"}, {"pk": 2138, "first_name": "Pertti J", "last_name": "Neuvonen"}, {"pk": 2139, "first_name": "Klaus T", "last_name": "Olkkola"}]}, "reference_date": "2011-08-01", "creator": {"username": "jbrandhorst", "first_name": "Janosch", "last_name": "Brandhorst"}, "curators": [{"rating": 0.0, "username": "jbrandhorst", "first_name": "Janosch", "last_name": "Brandhorst"}, {"rating": 3.2, "username": "mkoenig", "first_name": "Matthias", "last_name": "K\u00f6nig"}], "collaborators": [], "comments": [{"pk": 113, "username": "jbrandhorst", "text": "The youngest patients were scheduled for arthroscopic anterior cruciate ligament operation of the knee and the older patients for elective knee prosthesis operation."}, {"pk": 114, "username": "jbrandhorst", "text": "Patients using strong inhibitors or inducers of cytochrome P450 enzymes or having significant hepatic, renal, neurological, haematological, endocrine, metabolic or gastrointestinal diseases or a body mass index >35 kg/m^2 were excluded from the study."}, {"pk": 115, "username": "mkoenig", "text": "Patient characteristica in Table I."}], "descriptions": [{"pk": 959, "text": "We compared the pharmacokinetics of intravenous paracetamol in four groups of ten patients, aged 20\u201340, 60\u201370, 70\u201380 and 80\u201390 years, undergoing orthopaedic surgery."}, {"pk": 960, "text": "40 patients aged 20\u201390 years whose physical status was classified as I\u2013IV according to the American Society of Anaesthesiologists\u2019 physical status classification were included in this study."}, {"pk": 961, "text": "Ten patients were recruited to each of the following four groups: patients aged 20\u201340, 60\u201370, 70\u201380 and 80\u201390 years."}, {"pk": 962, "text": "Patients using strong inhibitors or inducers of cytochrome P450 enzymes or having significant hepatic, renal, neurological, haematological, endocrine, metabolic or gastrointestinal diseases or a body mass index >35 kg/m2 were excluded from the study. Patients were judged to have a significant hepatic, renal, neurological, haematological or gastrointestinal disease if they had a clinical diagnosis of any of the above diseases."}, {"pk": 963, "text": "Patients with diabetes mellitus were eligible unless they had significant renal involvement. Renal function was evaluated by estimating the glomerular filtration rate (GFR) from age and sex of the patient and his/her serum creatinine (SCr)."}, {"pk": 964, "text": "All patients were Caucasian."}, {"pk": 965, "text": "All except two male patients in the youngest group were non-smoking."}], "files": [{"pk": 4826, "name": "data/Liukas2011_Fig1.png", "file": "/media/data/Liukas2011_Fig1.png"}, {"pk": 4829, "name": "data/.Liukas2011