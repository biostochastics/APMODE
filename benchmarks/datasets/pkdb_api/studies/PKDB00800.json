{"pk": "1288", "sid": "PKDB00800", "name": "Tarkiainen2015", "licence": "open", "access": "public", "date": "2024-04-24", "group_count": 3, "individual_count": 0, "intervention_count": 1, "output_count": 110, "output_calculated_count": 24, "subset_count": 4, "timecourse_count": 4, "scatter_count": 0, "reference": {"pk": 1296, "study": {"sid": "PKDB00800", "name": "Tarkiainen2015"}, "pmid": "25919042", "sid": "25919042", "name": "Tarkiainen2015", "doi": "10.1111/bcp.12667", "title": "Effect of carboxylesterase 1 c.428G\u2009>\u2009A single nucleotide variation on the pharmacokinetics of quinapril and enalapril.", "abstract": "The aim of the present study was to investigate the effects of the carboxylesterase 1 (CES1) c.428G\u2009>\u2009A (p.G143E, rs71647871) single nucleotide variation (SNV) on the pharmacokinetics of quinapril and enalapril in a prospective genotype panel study in healthy volunteers.", "journal": "British journal of clinical pharmacology", "date": "2016-09-12", "authors": [{"pk": 7473, "first_name": "E Katriina", "last_name": "Tarkiainen"}, {"pk": 7474, "first_name": "Aleksi", "last_name": "Tornio"}, {"pk": 7475, "first_name": "Mikko T", "last_name": "Holmberg"}, {"pk": 7476, "first_name": "Terhi", "last_name": "Launiainen"}, {"pk": 7477, "first_name": "Pertti J", "last_name": "Neuvonen"}, {"pk": 7478, "first_name": "Janne T", "last_name": "Backman"}, {"pk": 7479, "first_name": "Mikko", "last_name": "Niemi"}]}, "reference_date": "2016-09-12", "creator": {"username": "shubhankarpalwankar", "first_name": "Shubhankar", "last_name": "Palwankar"}, "curators": [{"rating": 4.0, "username": "shubhankarpalwankar", "first_name": "Shubhankar", "last_name": "Palwankar"}, {"rating": 0.0, "username": "mkoenig", "first_name": "Matthias", "last_name": "K\u00f6nig"}], "collaborators": [], "comments": [], "descriptions": [{"pk": 4979, "text": "1109 young healthy Finnish volunteers for genotyping"}, {"pk": 4980, "text": "\ufb01ve women and seven men with the CES1 c.428G/G genotype [mean \u00b1 standard deviation: age 24 \u00b1 5 years, height 174 \u00b1 7 cm, weight 75 \u00b1 12 kg and body mass index (BMI) 25 \u00b1 4kgm\u20132]"}, {"pk": 4981, "text": "four women and six men with the CES1 c.428G/A genotype (age 26 \u00b1 4 years, height 177 \u00b1 14 cm, weight 70 \u00b1 14 kg and BMI 21 \u00b1 3 kg m\u20132) participated in a pharmacokinetic study"}, {"pk": 4982, "text": "In a \ufb01xed-order crossover study with two phases, follow- ing an overnight fast, the participants ingested a single 10 mg dose of quinapril"}, {"pk": 4983, "text": "after a washout period of at least 1 week, a single 10 mg dose of enalapril"}, {"pk": 4984, "text": "blood samples were drawn prior to and up to 24 h after quinapril ingestion, and prior to and up to 48 h after enalapril ingestion"}], "files": [{"pk": 15703, "name": "data/Tarkiainen2015_Fig1.png", "file": "/media/data/Tarkiainen2015_Fig1.png"}, {"pk": 15705, "name": "data/Tarkiainen2015_Fig2.png", "file": "/media/data/Tarkiainen2015_Fig2.png"}, {"pk": 15707, "name": "data/.Tarkiainen2015_Fig2.tsv", "file": "/media/data/.Tarkiainen2015_Fig2.tsv"}, {"pk": 15698, "name": "data/Tarkiainen2015.pdf", "file": "/media/data/Tarkiainen2015.pdf"}, {"pk": 15706, "name": "data/Tarkiainen2015_Tab1.png", "file": "/media/data/Tarkiainen2015_Tab1.png"}, {"pk": 15708, "name": "data/.Tarkiainen2015_Tab1.tsv", "file": "/media/data/.Tarkiainen2015_Tab1.tsv"}, {"pk": 15704, "name": "data/Tarkiainen2015_Tab2.png", "file": "/media/data/Tarkiainen2015_Tab2.png"}, {"pk": 15700, "name": "data/.Tarkiainen2015_Tab2.tsv", "file": "/media/data/.Tarkiainen2015_Tab2.tsv"}, {"pk": 15699, "name": "data/.Tarkiainen2015_TabGroups.tsv", "file": "/media/data/.Tarkiainen2015_TabGroups.tsv"}, {"pk": 15701, "name": "data/.Tarkiainen2015_TabInterventions.tsv", "file": "/media/data/.Tarkiainen2015_TabInterventions.tsv"}, {"pk": 15702, "name": "data/Tarkiainen2015.xlsx", "file": "/media/data/Tarkiainen2015.xlsx"}], "substances": [{"sid