{"pk": "1280", "sid": "PKDB00793", "name": "Ribeiro1996", "licence": "open", "access": "public", "date": "2024-04-24", "group_count": 1, "individual_count": 0, "intervention_count": 2, "output_count": 180, "output_calculated_count": 24, "subset_count": 6, "timecourse_count": 6, "scatter_count": 0, "reference": {"pk": 1288, "study": {"sid": "PKDB00793", "name": "Ribeiro1996"}, "pmid": "8839663", "sid": "8839663", "name": "Ribeiro1996", "doi": null, "title": "Bioequivalence study of two enalapril maleate tablet formulations in healthy male volunteers. Pharmacokinetic versus pharmacodynamic approach.", "abstract": "Two different conventional release enalapril maleate tablet formulations were evaluated for their relative bioavailability (Eupressin tablets 10 mg, Biosint\u00e9tica as the test formulation vs Renitec tablets 10 mg Merck Sharp & Dhome, as the reference formulation). A single 20 mg oral dose of each preparation was administered to 18 healthy male adult volunteers and their bioequivalence was assessed by comparing the serum enalaprilat and total enalapril (enalaprilat plus enalapril maleate) concentration-time curves. Angiotensin converting enzyme (ACE) activity was also quantified in each serum sample.", "journal": "European journal of clinical pharmacology", "date": "1996-12-26", "authors": [{"pk": 7423, "first_name": "W", "last_name": "Ribeiro"}, {"pk": 7424, "first_name": "M N", "last_name": "Muscar\u00e1"}, {"pk": 7425, "first_name": "A R", "last_name": "Martins"}, {"pk": 7426, "first_name": "H", "last_name": "Moreno"}, {"pk": 7427, "first_name": "G B", "last_name": "Mendes"}, {"pk": 7428, "first_name": "G", "last_name": "de Nucci"}]}, "reference_date": "1996-12-26", "creator": {"username": "shubhankarpalwankar", "first_name": "Shubhankar", "last_name": "Palwankar"}, "curators": [{"rating": 4.0, "username": "shubhankarpalwankar", "first_name": "Shubhankar", "last_name": "Palwankar"}, {"rating": 0.0, "username": "mkoenig", "first_name": "Matthias", "last_name": "K\u00f6nig"}], "collaborators": [], "comments": [], "descriptions": [{"pk": 4893, "text": "Eighteen healthy male adult volunteers, aged 20 to 36 y (mean (SEM) 30 (1) years), body weight 49.7 to 96.6 kg (mean (SEM) 70 (4) kg) participated in the study"}, {"pk": 4894, "text": "After an overnight fast, the subject received a single oral dose of 20 mg enalapril maleate (two 10 mg tablets) as either the test or the reference formulation, in a randomised cross-over manner"}, {"pk": 4895, "text": "Blood samples for serum drug quanti\ufb01cation were taken from a suitable forearm vein before and 0.5, 1, 1.5, 2, 3, 4, 5, 6, 8, 10, 12, 18 and 24 h after dosing"}], "files": [{"pk": 15590, "name": "data/Ribeiro1996_Fig1.png", "file": "/media/data/Ribeiro1996_Fig1.png"}, {"pk": 15582, "name": "data/.Ribeiro1996_Fig1.tsv", "file": "/media/data/.Ribeiro1996_Fig1.tsv"}, {"pk": 15583, "name": "data/Ribeiro1996_Fig2.png", "file": "/media/data/Ribeiro1996_Fig2.png"}, {"pk": 15586, "name": "data/.Ribeiro1996_Fig2.tsv", "file": "/media/data/.Ribeiro1996_Fig2.tsv"}, {"pk": 15594, "name": "data/Ribeiro1996_Fig3.png", "file": "/media/data/Ribeiro1996_Fig3.png"}, {"pk": 15587, "name": "data/.Ribeiro1996_Fig3.tsv", "file": "/media/data/.Ribeiro1996_Fig3.tsv"}, {"pk": 15584, "name": "data/Ribeiro1996.pdf", "file": "/media/data/Ribeiro1996.pdf"}, {"pk": 15585, "name": "data/Ribeiro1996_Tab1.png", "file": "/media/data/Ribeiro1996_Tab1.png"}, {"pk": 15589, "name": "data/.Ribeiro1996_Tab1.tsv", "file": "/media/data/.Ribeiro1996_Tab1.tsv"}, {"pk": 15588, "name": "data/Ribeiro1996_Tab2.png", "file": "/media/data/Ribeiro1996_Tab2.png"}, {"pk": 15593, "name": "data/.Ribeiro1996_Tab2.tsv", "file": "/media/data/.Ribeiro1996_Tab2.tsv"}, {"pk": 15592, "name": "data/.Ribeiro1996_TabGroups.tsv", "file": "/media/data/.Ribeiro1996_TabGroups.tsv"}, {"pk": 15591, "name": "data/.Ribeiro1996_TabInterventions.tsv", "file": "/media/data/.Ribeiro1996_TabInterventions.tsv"}, {"pk": 15581, "name": "data/Ribei