// SPDX-License-Identifier: GPL-2.0-or-later
// PK DSL Grammar — EBNF for Lark (PRD §4.2.5)
// Parse-only: no lowering or semantic validation at this stage.
// Semantic validation (dim ceilings, constraint enforcement) deferred to Phase 1.
//
// Top-level blocks may appear in any order (Formular sharpening plan §4
// Phase 1, P1.1): the grammar admits a flat, unordered list of blocks and
// ``apmode.dsl.grammar.compile_dsl`` runs a post-parse cardinality pass
// (exactly one absorption/distribution/elimination/observation, at most
// one metadata/initial, zero-or-more variability) before transforming.

start: model

model: "model" "{" model_body "}"

model_body: block*

block: absorption
     | distribution
     | elimination
     | variability_block
     | observation
     | observations_block
     | metadata_block
     | initial_block
     | units_block
     | priors_block
     | covariates_block
     | use_block

// --- Absorption Module ---
absorption: "absorption:" absorption_type

absorption_type: iv_bolus
              | first_order
              | zero_order
              | lagged_first_order
              | transit
              | mixed_first_zero
              | erlang
              | parallel_first_order
              | sum_ig
              | node_absorption

iv_bolus: "IVBolus" "(" ")"
first_order: "FirstOrder" "(" "ka" ")"
zero_order: "ZeroOrder" "(" "dur" ")"
lagged_first_order: "LaggedFirstOrder" "(" "ka" "," "tlag" ")"
transit: "Transit" "(" "n" "=" INT "," "ktr" "," "ka" ")"
mixed_first_zero: "MixedFirstZero" "(" "ka" "," "dur" "," "frac" ")"

// v0.7 SOTA absorption extensions (ADR-0003)
// Erlang: integer n transit compartments (structural), shared ktr
// (calibration, in initial:), no terminal ka. Lowers to explicit
// n-compartment ODE chain (not rxode2 transit() with gamma interpolation —
// semantics differ, see ADR-0003 D2).
erlang: "Erlang" "(" "n" "=" INT "," "ktr" ")"

// ParallelFirstOrder: two parallel first-order depots (fast + slow);
// fraction `frac` to depot 1. Pumas PK43 / Soufsaf 2021 PMX.
parallel_first_order: "ParallelFirstOrder" "(" "ka1" "," "ka2" "," "frac" ")"

// SumIG: sum of inverse Gaussian input rate functions
// (Csajka, Drover, Verotta 2005; Weiss & Wegner 2022). v0.7 ships k=2
// (structural); MT_1 < MT_2 enforced at validator (positive-difference
// parameterisation). weight_2 = 1 - weight_1 is implicit, not stored.
sum_ig: "SumIG" "(" "k" "=" INT "," "MT_1" "," "MT_2" "," "RD2_1" "," "RD2_2" "," "weight_1" ")"

node_absorption: "NODE_Absorption" "(" "dim" "=" INT "," "constraint_template" "=" CONSTRAINT_TEMPLATE ")"

// --- Distribution Module ---
distribution: "distribution:" distribution_type

distribution_type: one_cmt
                 | two_cmt
                 | three_cmt
                 | tmdd_core
                 | tmdd_qss

one_cmt: "OneCmt" "(" "V" ")"
two_cmt: "TwoCmt" "(" "V1" "," "V2" "," "Q" ")"
three_cmt: "ThreeCmt" "(" "V1" "," "V2" "," "V3" "," "Q2" "," "Q3" ")"
tmdd_core: "TMDD_Core" "(" "V" "," "R0" "," "kon" "," "koff" "," "kint" ")"
tmdd_qss: "TMDD_QSS" "(" "V" "," "R0" "," "KD" "," "kint" ")"

// --- Elimination Module ---
elimination: "elimination:" elimination_type

elimination_type: linear_elim
                | michaelis_menten
                | parallel_linear_mm
                | time_varying_elim
                | node_elimination

linear_elim: "Linear" "(" "CL" ")"
michaelis_menten: "MichaelisMenten" "(" "Vmax" "," "Km" ")"
parallel_linear_mm: "ParallelLinearMM" "(" "CL" "," "Vmax" "," "Km" ")"
// kdecay is not named inline: it is always an optional calibration value in
// initial: (defaults to 0.1 when omitted — see DSLSpec.get_initial callers).
time_varying_elim: "TimeVarying" "(" "CL" "," "decay_fn" "=" DECAY_FN ")"
node_elimination: "NODE_Elimination" "(" "dim" "=" INT "," "constraint_template" "=" CONSTRAINT_TEMPLATE ")"

// --- Variability Module (supports multiple components; zero-or-more variability: blocks) ---
variability_block: "variability:" "{" variability_item+ "}"
                 | "variability:" variability_item

variability_item: iiv | iov

iiv: "IIV" "(" "params" "=" param_list "," "structure" "=" STRUCTURE ")"
iov: "IOV" "(" "params" "=" param_list "," "occasions" "=" occasion_spec ")"

param_list: "[" NAME ("," NAME)* "]"

occasion_spec: occasion_by_study
             | occasion_by_visit
             | occasion_by_dose_epoch
             | occasion_custom

occasion_by_study: "ByStudy"
occasion_by_visit: "ByVisit" "(" NAME ")"
occasion_by_dose_epoch: "ByDoseEpoch" "(" NAME ")"
occasion_custom: "Custom" "(" NAME ")"

// --- Observation Module ---
observation: "observation:" observation_type

observation_type: proportional_obs
                | additive_obs
                | combined_obs
                | blq_m3
                | blq_m4

proportional_obs: "Proportional" "(" "sigma_prop" "=" NUMBER ")"
additive_obs: "Additive" "(" "sigma_add" "=" NUMBER ")"
combined_obs: "Combined" "(" "sigma_prop" "=" NUMBER "," "sigma_add" "=" NUMBER ")"
blq_m3: "BLQ_M3" "(" "loq_value" "=" NUMBER "," "error_model" "=" ERROR_MODEL "," "sigma_prop" "=" NUMBER "," "sigma_add" "=" NUMBER ")"
      | "BLQ_M3" "(" "loq_value" "=" NUMBER ")"
blq_m4: "BLQ_M4" "(" "loq_value" "=" NUMBER "," "error_model" "=" ERROR_MODEL "," "sigma_prop" "=" NUMBER "," "sigma_add" "=" NUMBER ")"
      | "BLQ_M4" "(" "loq_value" "=" NUMBER ")"

// --- Multi-analyte Observations Module (optional, additive to the singular
// `observation:` sugar above; Formular sharpening plan §4 Phase 1, P1.7).
// Exactly one of `observation:`/`observations:` must appear in a model {}
// (enforced on the raw parse tree by
// ``apmode.dsl.grammar._validate_block_cardinality``, same layer as the
// other block-cardinality checks) -- declaring both, or neither, fails to
// compile. Each entry names a DVID-routed analyte: `dvid` is the numeric
// DVID value observed rows for this analyte carry, `prediction` names the
// compiled model's predicted state/output this analyte observes (e.g.
// "C_central"; validated against ``DSLSpec.known_prediction_variables()``
// by the semantic validator, not here), and `error` is a normal
// observation_type residual-error declaration.
observations_block: "observations:" "{" observation_entry ("," observation_entry)* "}"

observation_entry: NAME ":" "{" "dvid" "=" INT "," "prediction" "=" NAME "," "error" "=" observation_type "}"

// --- Metadata Module (optional, at most one; Formular sharpening plan §4 Phase 1, P1.2) ---
metadata_block: "metadata:" "{" (metadata_item ("," metadata_item)*)? "}"

metadata_item: "title" "=" STRING -> metadata_title
             | "intent" "=" STRING -> metadata_intent
             | "context_of_use" "=" STRING -> metadata_context_of_use
             | "analyte" "=" STRING -> metadata_analyte
             | "version" "=" STRING -> metadata_version

// --- Initial-estimate Module (optional, at most one; P1.4) ---
initial_block: "initial:" "{" (initial_item ("," initial_item)*)? "}"

initial_item: NAME "=" NUMBER

// --- Units Module (optional, at most one; Formular sharpening plan §4
// Phase 1, P1.3). Declares the GLOBAL measurement units the spec's data
// and calibration values are expressed in -- not per-parameter unit
// annotations. All four fields are required when the block is present:
// the dimensional-homogeneity checker (apmode.dsl.units) needs all three
// base units (time, amount, concentration) plus the declared derived
// unit (volume) to verify internal self-consistency.
units_block: "units:" "{" "time" "=" unit_expr "," "amount" "=" unit_expr "," "concentration" "=" unit_expr "," "volume" "=" unit_expr "}"

// A unit token is either a bare word (e.g. "h", "L") or a compound
// mass/volume ratio (e.g. "ng/mL"). Expressed as a parser rule (not a
// dedicated lexer terminal) reusing NAME so it never competes with NAME
// for lexer priority.
unit_expr: NAME ("/" NAME)?

// --- Priors Module (optional, at most one top-level block; zero-or-more
// entries within; Formular sharpening plan §4 Phase 1, P1.5). Each entry is
// a human-authored Bayesian prior declaration lowered through
// apmode.dsl.priors.build_prior_spec -- the same canonical factory the
// agentic SetPrior transform routes through (apmode.dsl.prior_transforms) --
// so a hand-written prior and an LLM-proposed one are governed by identical
// classify_target/validate_prior_family invariants. That lowering happens
// in apmode.dsl.grammar.compile_dsl, not in the Transformer itself: Lark
// wraps any exception a Transformer callback raises in
// lark.exceptions.VisitError, which would bury build_prior_spec's plain
// ValueError (and the FormularCompileError wrapping it) behind an extra
// unwrap every caller would need to perform.
priors_block: "priors:" "{" prior_entry* "}"

prior_entry: NAME "~" prior_family prior_attr*

prior_attr: "source" "=" PRIOR_SOURCE -> prior_attr_source
          | "doi" "=" STRING -> prior_attr_doi
          | "justification" "=" STRING -> prior_attr_justification
          | "historical_refs" "=" string_list -> prior_attr_historical_refs

prior_family: normal_prior
            | lognormal_prior
            | halfnormal_prior
            | halfcauchy_prior
            | gamma_prior
            | invgamma_prior
            | beta_prior
            | lkj_prior
            | mixture_prior
            | historical_borrowing_prior

// Family syntax mirrors apmode.dsl.priors.PriorFamily field-for-field (same
// field names, same units -- e.g. LogNormal's mu/sigma are log-space) so a
// human-authored prior lowers to the same PriorSpec a Python caller gets
// from build_prior_spec() with equivalent arguments (P1.5 parity guarantee).
normal_prior: "Normal" "(" "mu" "=" numexpr "," "sigma" "=" numexpr ")"
lognormal_prior: "LogNormal" "(" "mu" "=" numexpr "," "sigma" "=" numexpr ")"
halfnormal_prior: "HalfNormal" "(" "sigma" "=" numexpr ")"
halfcauchy_prior: "HalfCauchy" "(" "scale" "=" numexpr ")"
gamma_prior: "Gamma" "(" "alpha" "=" numexpr "," "beta" "=" numexpr ")"
invgamma_prior: "InvGamma" "(" "alpha" "=" numexpr "," "beta" "=" numexpr ")"
beta_prior: "Beta" "(" "alpha" "=" numexpr "," "beta" "=" numexpr ")"
lkj_prior: "LKJ" "(" "eta" "=" numexpr ")"

// Mixture components exclude LKJ/Mixture/HistoricalBorrowing, mirroring
// MixturePrior.components' Python type union exactly.
mixture_component: normal_prior
                 | lognormal_prior
                 | halfnormal_prior
                 | halfcauchy_prior
                 | gamma_prior
                 | invgamma_prior
                 | beta_prior

prior_component_list: "[" mixture_component ("," mixture_component)* "]"
numexpr_list: "[" numexpr ("," numexpr)* "]"

mixture_prior: "Mixture" "(" "components" "=" prior_component_list "," "weights" "=" numexpr_list ")"

// robust_weight is optional (Python-side default 0.2 on HistoricalBorrowingPrior);
// historical_refs is required (min_length=1).
historical_borrowing_prior: "HistoricalBorrowing" "(" "map_mean" "=" numexpr "," "map_sd" "=" numexpr ("," "robust_weight" "=" numexpr)? "," "historical_refs" "=" string_list ")"

string_list: "[" (STRING ("," STRING)*)? "]"

// --- Covariates Module (optional, at most one top-level block;
// zero-or-more entries within; Formular sharpening plan §4 Phase 1, P1.6).
// Distinct from variability: -- IIV/IOV remain the sole variability item
// kinds; covariate effects are declared here with arrow syntax
// (``param <- covariate.form(...)``) and named, first-class reference-value
// fields per form. See apmode.dsl.ast_models.CovariateLink for the exact
// per-form field requirements (power: theta+ref; exponential/linear:
// theta; categorical: reference; maturation: tm50+hill).
covariates_block: "covariates:" "{" (covariate_entry ("," covariate_entry)*)? "}"

covariate_entry: NAME "<-" NAME "." covariate_form_call

covariate_form_call: power_form
                    | exponential_form
                    | linear_form
                    | categorical_form
                    | maturation_form

power_form: "power" "(" "theta" "=" numexpr "," "ref" "=" numexpr ")"
exponential_form: "exponential" "(" "theta" "=" numexpr ")"
linear_form: "linear" "(" "theta" "=" numexpr ")"
categorical_form: "categorical" "(" "reference" "=" STRING ")"
maturation_form: "maturation" "(" "tm50" "=" numexpr "," "hill" "=" numexpr ")"

// Minimal numeric-expression grammar (P1.5): a bare number, or a natural-log
// function call, so 'mu=log(4.0)' parses to the same float as Python's
// math.log(4.0) rather than requiring the author to pre-compute it by hand.
numexpr: NUMBER -> num_literal
       | "log" "(" numexpr ")" -> num_log

// --- Macro use (Formular sharpening plan §4 Phase 2, P2.1) ---
// `use <dotted.macro.name>` expands a small vetted standard-library macro
// (apmode.dsl.macros.MACRO_REGISTRY) into plain AST nodes AT PARSE TIME --
// but strictly as a pure post-transform function over the already-built
// DSLSpec (apmode.dsl.macros.expand_macros, invoked from
// apmode.dsl.grammar.compile_dsl), never via token-string substitution.
// Zero or more `use` statements may appear per spec -- like
// variability_block, it is deliberately absent from every set
// apmode.dsl.grammar._validate_block_cardinality checks, so 0, 1, or many
// are all legal without a bespoke cardinality rule.
use_block: "use" DOTTED_NAME

// --- Terminals ---
STRUCTURE: "diagonal" | "block"
CONSTRAINT_TEMPLATE: "monotone_increasing" | "monotone_decreasing" | "bounded_positive" | "saturable" | "unconstrained_smooth"
DECAY_FN: "exponential" | "half_life" | "linear"
ERROR_MODEL: "proportional" | "additive" | "combined"
PRIOR_SOURCE: "uninformative" | "weakly_informative" | "historical_data" | "expert_elicitation" | "meta_analysis" | "fixed_external"
INT: /[0-9]+/
NUMBER: /[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?/
// A dot-joined identifier chain, e.g. "pkstd.standard_iiv" (used only by
// use_block above). Built from NAME (already aliased to common.CNAME
// below) rather than referencing CNAME directly, since `%import
// common.CNAME -> NAME` renames the imported terminal to NAME and does
// not additionally leave a bare CNAME symbol defined in this grammar.
DOTTED_NAME: NAME ("." NAME)*

%import common.CNAME -> NAME
%import common.ESCAPED_STRING -> STRING
%import common.WS
%ignore WS
%ignore /\/\/.*/
